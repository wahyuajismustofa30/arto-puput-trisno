# git ls-files --others --exclude-from=.git/info/exclude
# Lines that start with '#' are comments.
# For a project mostly in C, the following would be a good set of
# exclude patterns (uncomment them if you want to use them):
# *.[oa]

# dependencies
node_modules/

# local env files
.env
.env.local
.env.*.local

# production
/build
/dist
.out

# misc
.DS_Store
Thumbs.db
.vscode/
.venv/
.idea/
*.log
desktop.ini

# vercel config
.vercel/

# testing
coverage/

#dev tools
py/
dev/
tmp/
draf/

# editor temp
*.swp
*.swo
*~
*.txt
*.bat
*.sh
*.bak